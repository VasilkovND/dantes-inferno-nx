+/*
+ * FPS Locker: its overlay writes the target into the block (FPSlocked handheld, FPSlockedDocked docked; 0 = off),
+ * and NX-FPS, which cannot hook us, would hold each present until 1/target s after the previous one. The same is done
+ * here, as NX-FPS does it for Vulkan (saltysd_core NX-FPS-Common.hpp, PreFrame/PostFrame): only below the screen's
+ * refresh rate, 6000 ticks early, and a margin that grows while the average stays above the target. With no target
+ * nothing waits: the game runs as fast as it can.
  */
+static void EsperarBloqueo(BloqueFps* bloque) {
+  static uint64_t fin_previo = 0;  // ring thread only, like g_tick_previo
+  static uint64_t media = 0;
+  static uint32_t margen = 0;
+  const bool en_base = ModoBase(appletGetOperationMode() == AppletOperationMode_Console);
+  const uint32_t objetivo = en_base ? bloque->fps_bloqueados_base : bloque->fps_bloqueados;
+  // SaltyNX keeps the display's refresh rate in the page's second byte (FPS Locker reads it there too).
+  const uint8_t refresco_compartido = g_base ? g_base[1] : 0;
+  const uint32_t refresco = refresco_compartido >= 30 && refresco_compartido <= 120 ? refresco_compartido : 60;
+  bloque->refresco_actual = uint8_t(refresco);
+  const uint64_t frecuencia = armGetSystemTickFreq();
+  bool esperado = false;
+  if (objetivo && objetivo < refresco && fin_previo) {
+    const int64_t plazo = int64_t(frecuencia / objetivo) - 6000 + int64_t(margen) * 32;
+    while (int64_t(armGetSystemTick() - fin_previo) < plazo) {
+      esperado = true;
+      svcSleepThread(10000);
+    }
+  } else {
+    margen = 0;
+  }
+  const uint64_t fin = armGetSystemTick();
+  if (fin_previo) {
+    media = (9 * media + (fin - fin_previo)) / 10;
+    if (esperado && media) {
+      const double fps = double(frecuencia) / double(media);
+      if (fps > double(objetivo)) {
+        if (margen < 200) ++margen;
+      } else if (uint32_t(fps + 0.5) == objetivo && margen > 0) {
+        --margen;
+      }
+    }
+  }
+  fin_previo = fin;
+}
