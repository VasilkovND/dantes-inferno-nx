+/*
+ * FPS Locker's saved target for this title (sdmc:/SaltySD/plugins/FPSLocker/<TID>.dat, written by its overlay):
+ * byte 0 the handheld target, byte 4 the docked one when the file has it. NX-FPS reads it into the block when the
+ * game starts; it cannot hook us, so it is read here, once, when the block is found.
+ */
+void CargarBloqueoGuardado(BloqueFps* bloque) {
+  static bool cargado = false;
+  if (cargado) {
+    return;
+  }
+  cargado = true;
+  u64 titulo = 0;
+  if (R_FAILED(svcGetInfo(&titulo, InfoType_ProgramId, CUR_PROCESS_HANDLE, 0))) {
+    return;
+  }
+  char ruta[96];
+  std::snprintf(ruta, sizeof(ruta), "sdmc:/SaltySD/plugins/FPSLocker/%016llX.dat", (unsigned long long)titulo);
+  FILE* f = std::fopen(ruta, "rb");
+  if (!f) {
+    return;
+  }
+  uint8_t datos[5] = {};
+  const size_t leidos = std::fread(datos, 1, sizeof(datos), f);
+  std::fclose(f);
+  if (leidos >= 1) {
+    bloque->fps_bloqueados = datos[0];
+    bloque->fps_bloqueados_base = leidos >= 5 ? datos[4] : datos[0];
+    std::fprintf(stderr, "[saltynx] FPS Locker: objetivo guardado %u (portatil) / %u (base) en %s\n",
+                 unsigned(bloque->fps_bloqueados), unsigned(bloque->fps_bloqueados_base), ruta);
+  }
+}
