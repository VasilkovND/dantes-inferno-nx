+/*
+ * Dante's Inferno (dantes-inferno-nx): the VP6 decoder for the game's FMVs (EA VP6, 1280x720), which the game's own
+ * decoder, recompiled, cannot run in real time. vp6_decoder_select = "h264chroma hpeldsp huffman videodsp vp3dsp
